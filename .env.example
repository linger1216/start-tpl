# ─────────────────────────────────────────────────────────────
# 模板环境变量样例。
#
# 新项目:new-project.sh 会自动据此生成 .env.local 并填好
#         BETTER_AUTH_SECRET,你只需补上 DATABASE_URL 等真实值。
# 手动:  cp .env.example .env.local
#
# .env.local 已被 .gitignore 忽略,且不会被 new-project.sh 复制。
# 本文件不含任何真实凭据,是唯一随模板分发的 env 文件。
# ─────────────────────────────────────────────────────────────

# --- Sentry ---
# 留空则不启用 Sentry(instrument.server.mjs 会打印一条提示)
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- 数据库 (MySQL) ---
DATABASE_URL="mysql://username:password@localhost:3306/mydb"

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:3000
# 生成密钥: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
