# ─────────────────────────────────────────────────────────────
# 模板环境变量样例。
#
# 新项目:new-project.sh 会自动据此生成 .env.local 并填好
#         BETTER_AUTH_SECRET,你只需补上 DATABASE_URL 等真实值。
# 手动:  cp .env.example .env.local
#
# .env.local 已被 .gitignore 忽略,且不会被 new-project.sh 复制。
# 本文件不含任何真实凭据,是唯一随模板分发的 env 文件。
# ─────────────────────────────────────────────────────────────

# --- 数据库 (MySQL) ---
DATABASE_URL="mysql://username:password@localhost:3306/mydb"

# --- Better Auth ---
# 生成密钥: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=

# origin 白名单(Better Auth 用它拦跨站 POST;不匹配就 403 Invalid origin)。
# 逗号分隔。代码内置两条:http://localhost:3000 与 https://*.localhost,
# 这里只写「额外」要放行的。
#
#   http://localhost:3000          直连 dev 默认端口(已内置,不必再写)
#   https://*.localhost            portless 的 https://xxx.localhost(通配符要留着!)
#   https://app.example.com       自建域名 / 反向代理入口
#
# ⚠️ 通配符是 **单段** 匹配:`https://*.localhost` 覆盖 xxx.localhost,不覆盖 a.b.localhost。
#    不带 `://` 的写法(如 `*.localhost`)只比主机名、不比协议,别用。
BETTER_AUTH_TRUSTED_ORIGINS=

# tRPC 传输方式:留空 = 非流式(httpBatchLink)—— 响应是一份完整 JSON,DevTools 的
# Response / Preview 能直接看,排查方便(默认)。
# 设 1 = 流式(httpBatchStreamLink)—— 响应是 JSONL「引用协议」,人和 DevTools 都读不了,
# 只在"批量里某个调用很慢、想让它先返回"或接 SSE 订阅时才需要。
VITE_TRPC_STREAM=

# --- 人机验证(CaptchaKit 自托管;见 doc/后端代码导读.md §3.1.1)──
# **这行是「密钥」,不是「开关」。** 开关在「系统设置 ▸ 参数管理」的参数 `login.captcha_enabled`
# (默认开;关掉后登录接口不再要求验证码,只剩限流 + 账号锁定兜底 —— 生产不建议关)。
#   - 填了(至少 32 个字符)→ 用你填的这把,想轮换就改这里;
#   - **留空 → 首次访问 /api/captcha 时自动生成 32 字节随机值并回填到 .env.local**,
#     重启不变(`src/lib/captcha-secret.ts`)。忘了配不会让登录接口裸奔 —— 只是换一把随机密钥。
# 登录页默认显示验证码栏,提交登录必须带 proof token;绕过前端直打 /api/auth/sign-in/email
# 会被 `lib/auth.ts` 的 `hooks.before` 同一处拦下(关掉上面那个参数时两边一起放行)。
# 生成: openssl rand -hex 32
CAPTCHAKIT_SECRET=

# --- 邮件(Nodemailer SMTP;见 src/lib/mailer.ts)─────────────────
# **留空 = 开发态驱动(console)**:验证链接只打到 `pnpm dev` 那个终端窗口,不真发。
#   生产必须换掉 —— 否则用户永远收不到邮箱验证信。
# 设 smtp 才走真发。企业邮 / 阿里邮箱 / Exchange / 自建 Postfix 都有 SMTP,一条路覆盖全部。
MAIL_DRIVER=
SMTP_HOST=
SMTP_PORT=
# 465 端口是隐式 TLS;587 是明文连上再 STARTTLS。留空按端口自动判断(465 ⇒ 隐式)。
SMTP_SECURE=
# 成对填;内网 relay 不鉴权时两个都留空。只填一半会在发信时直接报配置错。
SMTP_USER=
SMTP_PASS=
# 自签证书的 relay 设 1 才放行(默认走 Node 的证书校验)。
SMTP_ALLOW_SELF_SIGNED=
# 收件人看到的发件人,可带显示名:后台系统 <no-reply@example.com>
MAIL_FROM=

# ── MinIO(文件管理;见 doc/文件管理.md)─────────────────────────
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PUBLIC=
MINIO_BUCKET_PRIVATE=
MINIO_PUBLIC_URL=
