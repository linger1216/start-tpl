{
  "name": "start-tpl",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "generate-routes": "tsr generate",
    "build": "vite build && cp instrument.server.mjs .output/server",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "LOG_SILENT=1 dotenv -e .env.local -- node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:create": "dotenv -e .env.local -- tsx scripts/create-system-tables.ts",
    "db:migrate:ids": "dotenv -e .env.local -- tsx scripts/migrate-ids-to-nanoid.ts",
    "db:sync:meta": "dotenv -e .env.local -- tsx scripts/sync-table-meta.ts",
    "db:dm:poc": "tsx scripts/dm-poc.ts",
    "db:dm:smoke": "dotenv -e .env.local -- tsx scripts/dm-drizzle-smoke.ts",
    "db:dm:defaults": "dotenv -e .env.local -- tsx scripts/dm-sync-defaults.ts",
    "db:seed:menus": "dotenv -e .env.local -- tsx scripts/seed-menus.ts",
    "db:seed:dicts": "dotenv -e .env.local -- tsx scripts/seed-dicts.ts",
    "db:seed:paras": "dotenv -e .env.local -- tsx scripts/seed-paras.ts",
    "db:minio:init": "dotenv -e .env.local -- tsx scripts/init-minio.ts",
    "db:seed:tags": "dotenv -e .env.local -- tsx scripts/seed-tags.ts",
    "db:seed:rbac": "dotenv -e .env.local -- tsx scripts/seed-rbac.ts",
    "check:legacy": "node scripts/check-legacy.mjs",
    "db:dm:create-ba": "dotenv -e .env.local -- tsx scripts/create-better-auth-tables-dm.ts",
    "db:seed:demo": "dotenv -e .env.local -- tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/tanstackstart-react": "^10.67.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "^9.1.2",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.50",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/store": "^0.11.1",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dmdb": "^1.0.52452",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "minio": "^8.0.7",
    "mysql2": "^3.15.3",
    "nanoid": "^6.0.1",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
