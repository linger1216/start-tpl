      "default": false,
      "requires": [],
      "procedures": 25,
      "paths": [
        "src/components/modules/task-close",
        "src/routes/(main)/task-close",
        "src/integrations/trpc/routers/task-close.ts",
        "src/lib/task-close-log.ts",
        "src/lib/task-close-spec.ts",
        "src/lib/task-content.ts",
        "scripts/seed-task-close.ts",
        "tests/task-close.test.ts",
        "tests/task-close-log.test.ts",
        "tests/task-content.test.ts",
        "doc/task-close.md"
      ],
      "tokens": [
        "taskCloseRouter",
        "#/integrations/trpc/routers/task-close",
        "#/components/modules/task-close",
        "#/lib/task-close-log",
        "#/lib/task-close-spec",
        "#/lib/task-content"
      ],
      "rules": [
        { "file": "src/integrations/trpc/router.ts", "kind": "imports", "from": ["./routers/task-close"] },
        {
          "file": "src/integrations/trpc/router.ts",
          "kind": "lines",
          "matches": ["taskClose: taskCloseRouter,"],
          "prefixes": ["/** 任务闭环"],
          "min": 2
        },
        {
          "file": "src/components/layout/nav-config.ts",
          "kind": "block",
          "begin": "^\\t\\tname: \"任务闭环\",$",
          "back": "^\\t\\{$",
          "end": "^\\t\\},$"
        },
        { "file": "src/lib/rbac.ts", "kind": "block", "begin": "^\\t\"taskClose\\.workflowGet\": pagePermOf", "end": "^\\t\"taskClose\\.workflowRemove\"" },
        { "file": "src/lib/rbac.ts", "kind": "block", "begin": "^\\t\"taskClose\\.workflowList\",$", "end": "^\\t\"taskClose\\.attachmentUrl\",$" },
        { "file": "src/lib/rbac.ts", "kind": "block", "begin": "^\\t\"taskClose\\.taskCreate\",$", "end": "^\\t\"taskClose\\.commentRemove\",$" },
        {
          "file": "src/db/data-base-schema.ts",
          "kind": "block",
          "begin": "^export const taskClose",
          "back": "^/\\*\\*",
          "end": "^\\}\\);$|^\\);$"
        },
        {
          "file": "scripts/create-system-tables.ts",
          "kind": "block",
          "begin": "^\\t\\tname: \"tc_",
          "back": "^\\t(?:\\{|/\\*\\*)",
          "dropLeadingComments": true,
          "end": "^\\t\\},$"
        },
        {
          "file": "scripts/sync-table-meta.ts",
          "kind": "lines",
          "matches": ["tc_workflow:", "tc_log:"],
          "plus": 1,
          "min": 2
        },
        {
          "file": "scripts/sync-table-meta.ts",
          "kind": "lines",
          "prefixes": [
            "tc_workflow: \"", "tc_task:", "tc_action:", "tc_member:", "tc_comment:",
            "{ table: \"tc_", "// tc_", "// ── 任务闭环"
          ],
          "min": 40
        },
        { "file": "package.json", "kind": "json", "matches": ["scripts.db:seed:task-close"] }
      ],
      "tables": ["tc_workflow", "tc_task", "tc_action", "tc_member", "tc_comment", "tc_log"],
      "seeds": [],
      "hints": [
        "`tc_*` 六张表不再建;`pnpm db:create` 只建剩下的表",
        "tests/nav.test.ts 用 `/task-close/workflows` 当菜单夹具 —— 裁掉后跑 `pnpm test` 要先把那里的路径换成自己的页面"
      ]
    },
