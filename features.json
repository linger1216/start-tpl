        },
        {
          "file": "src/routes/(main)/index.tsx",
          "kind": "replace",
          "from": "component: WorkbenchPage,",
          "to": "component: () => <EmptyState title=\"欢迎使用\" description=\"请从侧边栏选择功能。\" />,"
        },
        {
          "file": "src/components/layout/nav-config.ts",
          "kind": "block",
          "begin": "^\\t\\tname: \"工作台\",$",
          "back": "^\\t\\{$",
          "end": "^\\t\\},$"
        }
      ],
      "tables": [],
      "seeds": [],
      "hints": ["`/` 已保留基础首页，可按业务替换"]
    },
    {
