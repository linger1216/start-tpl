{
  "version": 1,
  "_readme": [
    "功能切分的唯一真源:new-project.sh 读它做交互与依赖补齐,scripts/prune-features.mjs 读它做裁剪。",
    "改这里的三条纪律(与 tests/auth.test.ts 的分类守卫同一个立场 —— 漏了就直接红):",
    "  1. 每条规则都必须命中,命中 0 处 = 派生中止(模板重构后请同步这里的规则);",
    "  2. tokens 只放**构建会炸**的东西(import 路径 / 掉不掉的标识符);注释里的中文提及交给收尾报告的「残留提及」。",
    "规则种类:paths / lines(matches、prefixes、plus、min) / block(begin、end、back) / imports(from[]) / json(matches) / replace(from、to、count)。"
  ],
  "core": {
    "seeds": ["db:seed:menus", "db:seed:rbac", "db:seed:paras", "db:seed:dicts"]
  },
  "features": [
    {
      "id": "task-close",
      "name": "任务闭环",
      "category": "业务流程",
      "description": "甲发任务给乙 → 处置 → 审批 → 关闭归档(含活动日志 tc_log)",
      "tip": "工单/审批流业务选配；常规基础后台无流转需求可不选",
      "default": false,
      "requires": ["notice"],
      "paths": [
        "src/components/modules/task-close",
        "src/routes/(main)/task-close",
        "src/integrations/trpc/routers/task-close.ts",
        "src/lib/task-close-log.ts",
        "src/lib/task-close-spec.ts",
        "src/lib/task-content.ts",
        "scripts/seed-task-close.ts",
        "tests/task-close.test.ts",
        "tests/task-close-log.test.ts",
        "tests/task-content.test.ts",
        "doc/task-close.md",
        "doc/task-forms.md",
        "doc/任务插件化设计.md"
      ],
      "tokens": [
        "taskCloseRouter",
        "#/integrations/trpc/routers/task-close",
        "#/components/modules/task-close",
        "#/lib/task-close-log",
        "#/lib/task-close-spec",
        "#/lib/task-content"
      ],
      "rules": [
        { "file": "src/integrations/trpc/router.ts", "kind": "imports", "from": ["./routers/task-close"] },
        { "file": "src/lib/use-notice-sse.ts", "kind": "lines", "matches": ["void queryClient.invalidateQueries(trpc.taskClose.pathFilter());"], "prefixes": ["// 「我的任务」红点也吃通知"] },
        { "file": "src/components/layout/sidebar.tsx", "kind": "imports", "from": ["@tanstack/react-query", "#/integrations/trpc/react"] },
        { "file": "src/components/layout/sidebar.tsx", "kind": "lines", "matches": ["const trpc = useTRPC();", "const badgeQuery = useQuery({ ...trpc.taskClose.menuBadge.queryOptions(), refetchInterval: 30_000 });"], "prefixes": ["// 「我的任务」红点:", "// 新通知由 SSE"] },
        { "file": "src/components/layout/sidebar.tsx", "kind": "replace", "from": "const taskDot = (badgeQuery.data?.count ?? 0) > 0;", "to": "const taskDot = false;" },
        { "file": "src/routes/(main)/route.tsx", "kind": "lines", "matches": ["context.queryClient.ensureQueryData(context.trpc.taskClose.menuBadge.queryOptions()).catch(() => undefined),"] },
        {
          "file": "src/integrations/trpc/router.ts",
          "kind": "lines",
          "matches": ["taskClose: taskCloseRouter,"],
          "prefixes": ["/** 任务闭环"],
          "min": 2
        },
        {
          "file": "src/components/layout/nav-config.ts",
          "kind": "block",
          "begin": "^\\t\\tname: \"任务闭环\",$",
          "back": "^\\t\\{$",
          "end": "^\\t\\},$"
        },
        { "file": "src/lib/rbac.ts", "kind": "block", "begin": "^\\t\"taskClose\\.workflowGet\": pagePermOf", "end": "^\\t\"taskClose\\.workflowRemove\"" },
        { "file": "src/lib/rbac.ts", "kind": "lines", "matches": ["\"taskClose.menuBadge\","], "prefixes": ["// 类别 1:外壳级 —— 「我的任务」侧栏红点", "// 类别 1:外壳级 —— 侧边栏「我的任务」的红点徽标"], "min": 4 },
        { "file": "src/lib/rbac.ts", "kind": "block", "begin": "^\\t\"taskClose\\.workflowList\",$", "end": "^\\t\"taskClose\\.attachmentUrl\",$" },
        { "file": "src/lib/rbac.ts", "kind": "block", "begin": "^\\t\"taskClose\\.taskCreate\",$", "end": "^\\t\"taskClose\\.commentRemove\",$" },
        {
          "file": "src/db/data-base-schema.ts",
          "kind": "block",
          "begin": "^export const taskClose",
          "back": "^/\\*\\*",
          "end": "^\\}\\);$|^\\);$"
        },
        {
          "file": "scripts/create-system-tables.ts",
          "kind": "block",
          "begin": "^\\t\\tname: \"tc_",
          "back": "^\\t(?:\\{|/\\*\\*)",
          "dropLeadingComments": true,
          "end": "^\\t\\},$"
        },
        {
          "file": "scripts/sync-table-meta.ts",
          "kind": "lines",
          "matches": ["tc_workflow:", "tc_log:"],
          "plus": 1,
          "min": 2
        },
        {
          "file": "scripts/sync-table-meta.ts",
          "kind": "lines",
          "prefixes": [
            "tc_workflow: \"", "tc_task:", "tc_action:", "tc_member:", "tc_comment:",
            "{ table: \"tc_", "// tc_", "// ── 任务闭环"
          ],
          "min": 40
        },
        { "file": "package.json", "kind": "json", "matches": ["scripts.db:seed:task-close"] }
      ],
      "tables": ["tc_workflow", "tc_task", "tc_action", "tc_member", "tc_comment", "tc_log"],
      "seeds": [],
      "hints": [
        "`tc_*` 六张表不再建;`pnpm db:create` 只建剩下的表"
      ]
    },
    {
      "id": "demo",
      "name": "框架能力 + 演示页",
      "category": "演示示例",
      "description": "6 个能力样例页 + 2 个演示业务页(业务首页 / 网格履职)+ demo_grid 表",
      "tip": "综合网格履职演示业务与数据权限样例页；正式生产工程通常不需要",
      "default": false,
      "requires": [],
      "paths": [
        "src/routes/(main)/demo",
        "src/components/modules/demo",
        "src/hooks/demo.form.tsx",
        "src/hooks/demo.form-context.ts",
        "src/lib/demo-store.ts",
        "src/integrations/trpc/routers/demo-grid.ts",
        "scripts/seed-demo.ts",
        "tests/data-scope.test.ts",
        "doc/测试数据"
      ],
      "tokens": ["demoGridRouter", "#/integrations/trpc/routers/demo-grid", "#/components/modules/demo", "#/lib/demo-store"],
      "rules": [
        { "file": "src/integrations/trpc/router.ts", "kind": "imports", "from": ["./routers/demo-grid"] },
        {
          "file": "src/integrations/trpc/router.ts",
          "kind": "lines",
          "matches": ["demoGrid: demoGridRouter,"],
          "prefixes": ["/** Demo:综合网格履职"],
          "min": 2
        },
        {
          "file": "src/components/layout/nav-config.ts",
          "kind": "block",
          "begin": "^\\t\\tname: \"Demo\",$",
          "back": "^\\t\\{$",
          "end": "^\\t\\},$"
        },
        {
          "file": "src/components/layout/nav-config.ts",
          "kind": "block",
          "begin": "^\\t\\tname: \"框架能力\",$",
          "back": "^\\t\\{(\\n\\t\\t//.*)?$",
          "end": "^\\t\\},$"
        },
        { "file": "src/lib/rbac.ts", "kind": "block", "begin": "^\\t\"demoGrid\\.list\": pagePermOf", "end": "^\\t\"demoGrid\\.assign\"" },
        { "file": "src/lib/rbac.ts", "kind": "lines", "matches": ["\"demoGrid.list\": { resource: \"demo_grid\" },"] },
        {
          "file": "src/db/data-base-schema.ts",
          "kind": "block",
          "begin": "^export const sysDemoGrid",
          "back": "^/\\*\\*",
          "end": "^\\}\\);$|^\\);$"
        },
        {
          "file": "scripts/create-system-tables.ts",
          "kind": "block",
          "begin": "^\\t\\tname: \"demo_grid\",$",
          "back": "^\\t(?:\\{|/\\*\\*)",
          "dropLeadingComments": true,
          "end": "^\\t\\},$"
        },
        {
          "file": "scripts/sync-table-meta.ts",
          "kind": "lines",
          "matches": ["demo_grid: \"Demo:综合网格履职\","],
          "prefixes": ["{ table: \"demo_grid\"", "// demo_grid"],
          "min": 11
        },
        {
          "file": "package.json",
          "kind": "json",
          "matches": [
            "scripts.db:seed:demo",
            "dependencies.@tanstack/react-form",
            "dependencies.@tanstack/react-store",
            "dependencies.@tanstack/store"
          ]
        }
      ],
      "tables": ["demo_grid"],
      "seeds": [],
      "hints": ["数据权限核心 SQL 过滤与规则规格测试保留；依赖 demo_grid 的预览、CRUD 和接口链测试仍随 demo 移除"]
    },
    {
      "id": "workbench",
      "name": "工作台 + UI 示例",
      "category": "业务流程",
      "description": "落地页(上手清单 / 目录速查)+ 41 个原语与 16 个展示件的活文档(ui-gallery)",
      "tip": "首页上手清单 + 41 个 UI 原语与展示件活文档；已有专有首页可不选",
      "default": true,
      "requires": [],
      "paths": ["src/components/modules/workbench"],
      "tokens": ["#/components/modules/workbench"],
      "rules": [
        {
          "file": "src/routes/(main)/index.tsx",
