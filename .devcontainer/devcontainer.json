{
	// 打开方式:VS Code →「Dev Containers: Reopen in Container」。
	// 起的是 docker-compose.yml + docker-compose.dev.yml 里的 dev / mysql / minio 三个服务;
	// dev 服务把仓库挂到 /app,依赖装在命名卷里(见 docker-compose.dev.yml 的注释)。
	"name": "开发容器",
	"dockerComposeFile": ["../docker-compose.yml", "../docker-compose.dev.yml"],
	"service": "dev",
	// 只起这三个:避免把生产镜像(app)也建出来
	"runServices": ["mysql", "minio", "dev"],
	"workspaceFolder": "/app",
	"shutdownAction": "stopCompose",
	// node_modules 在命名卷里,首次进来是空的
	"postCreateCommand": "pnpm install",
	// 转发到宿主机:3000 应用 / 3307 MySQL / 9000 MinIO API / 9001 MinIO 控制台。
	// 端口映射同样写在 compose 里,所以这些端口在宿主机上本来就通。
	"forwardPorts": [3000, 3307, 9000, 9001],
	"portsAttributes": {
		"3000": { "label": "应用(Vite dev / Nitro)" },
		"3307": { "label": "MySQL" },
		"9000": { "label": "MinIO API" },
		"9001": { "label": "MinIO 控制台" }
	},
	"customizations": {
		"vscode": {
			"extensions": ["biomejs.biome", "bradlc.vscode-tailwindcss"],
			"settings": {
				"editor.defaultFormatter": "biomejs.biome",
				"editor.formatOnSave": true
			}
		}
	}
}
