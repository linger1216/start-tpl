# ─── 依赖 ───────────────────────────────────────────────
node_modules
# 本机 pnpm 使用「项目内 store」(可达数百 MB),绝不能入库或被派生复制
.pnpm-store
.pnp
.pnp.js
jspm_packages

# ─── 构建产物 ───────────────────────────────────────────
# Nitro 产物目录是 .output/,不是 dist/
dist
dist-ssr
.output
.nitro
.vinxi
build
.vite
vite.config.*.timestamp-*
*.tsbuildinfo

# ─── 框架 / 工具缓存 ────────────────────────────────────
# TanStack Router / Devtools 的临时目录
.tanstack
# 注意:生成物 src/routeTree.gen.ts 属于源码要入库,不要在这里忽略它
.turbo
.wrangler
__unconfig*
todos.json
.eslintcache
.stylelintcache

# ─── 环境变量(绝不入库) ─────────────────────────────────
# .env.example 是唯一随模板分发的 env 文件,不含真实凭据
.env
.env.*
!.env.example
*.local

# ─── 密钥 / 凭据(绝不入库) ──────────────────────────────
# Sentry CLI 配置里含 auth token
.sentryclirc
.sentryclirc.*
sentry.properties
# 本地 HTTPS 调试证书 / 私钥
*.pem
*.key
*.p12
*.pfx

# ─── 日志 ───────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── 测试 / 覆盖率 ──────────────────────────────────────
coverage
.nyc_output
*.lcov
test-results
playwright-report
blob-report
playwright/.cache

# ─── 数据库 / 迁移本地产物 ──────────────────────────────
# ./drizzle 下的迁移 SQL 与 meta 属于源码,必须入库
*.sqlite
*.sqlite3
*.db
*.db-journal
.mysql_history

# ─── 系统文件 ───────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# ─── 编辑器 / IDE ───────────────────────────────────────
.idea/
*.iml
*.swp
*.swo
*~
.history/
.vscode/*
# .vscode/settings.json 是共享的编辑器配置(见 AGENTS.md),必须入库
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets

# ─── 临时 / 备份文件 ────────────────────────────────────
*.bak
*.tmp
*.orig
*.rej
*.pid
*.seed
*.tgz
.cache/

# ─── 部署平台 ───────────────────────────────────────────
.vercel
.netlify
.firebase/
.serverless/

# macOS 垃圾文件
.DS_Store
# xlsx 一律不入库,例外:demo 种子的对账数据源(scripts/seed-demo.ts 硬依赖)是业务提供的长期夹具
*.xlsx
!doc/测试数据/*.xlsx
*.html

# ─── AI / 编辑器工具的本地状态 ──────────────────────────
# ⚠️ 这两个目录**此前已有文件入库**(.commandcode/taste/taste.md、.workbuddy/memory/*.md):
#    要不要一并 `git rm --cached` 由你决定 —— 规则只保证**以后新增的**不会再进来。
.commandcode
.workbuddy
# 设计评审工具(impeccable)的本地状态:hooks 配置与机器生成的 critique 快照,不入库
.claude
.impeccable/critique/
# .serena 是 agent(Serena MCP)的本地索引状态:**不是**项目内容,派生新项目时不该被带走
# (new-project.sh 按 .gitignore 派生)。不忽略它,`--strict` 还会被这条工具状态**永久**判成脏。
.serena/

.codex
.cursor
.gemini
.grok
